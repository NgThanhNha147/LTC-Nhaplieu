# Copy this file to .env before running Docker Compose.
COMPOSE_PROJECT_NAME=dynamic-form-platform

# PostgreSQL
POSTGRES_DB=dynamic_form
POSTGRES_USER=dynamic_form
POSTGRES_PASSWORD=change_me_in_real_environments
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
DOCUMENT_STORAGE_PATH=/app/data/documents
EXPORT_MAX_ROWS=10000
APP_SECURITY_ENABLED=true
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
JWT_REFRESH_COOKIE_SECURE=false
INITIAL_ADMIN_ENABLED=true
INITIAL_ADMIN_USERNAME=ltc@admin
INITIAL_ADMIN_PASSWORD=replace_before_enabling_initial_admin
INITIAL_ADMIN_DISPLAY_NAME=Quan tri he thong
OCR_ENABLED=false
OCR_SERVICE_URL=http://ocr:8090
OCR_LANGUAGES=vie+eng
OCR_MAX_FILE_BYTES=41943040
OCR_TIMEOUT_SECONDS=180
OCR_WORKERS=2

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_SECURITY_ENABLED=true

# Backup/restore scripts (local operator settings)
BACKUP_ROOT=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_ARCHIVE_IMAGE=alpine:3.20

